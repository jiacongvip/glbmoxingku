e":{"type":"string","description":"YYYY-MM-DD"}}},"source_plugin":"aiapi"},{"name":"member.address.list","title":"会员·收货地址","desc":"查询会员收货地址。传 mid 查该会员，不传则按最近添加列出","rw":"read","permission":"Member\/index","module":"core:member","is_delete":0,"params":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"mid":{"type":"integer"},"keyword":{"type":"string","description":"收货人、手机号或地址"}}},"source_plugin":"aiapi"},{"name":"member.adjust_money","title":"会员·调余额","desc":"调整会员余额。amount 正数增加，负数扣除","rw":"write","permission":"Member\/recharge","module":"core:member","is_delete":0,"params":{"type":"object","required":["id","amount"],"properties":{"id":{"type":"integer"},"amount":{"type":"number"},"remark":{"type":"string"},"dry_run":{"type":"boolean"}}},"source_plugin":"aiapi"},{"name":"member.adjust_commission","title":"会员·调佣金","desc":"调整会员佣金。amount 正数增加，负数扣除","rw":"write","permission":"Member\/addcommission","module":"core:member","is_delete":0,"params":{"type":"object","required":["id","amount"],"properties":{"id":{"type":"integer"},"amount":{"type":"number"},"remark":{"type":"string"},"dry_run":{"type":"boolean"}}},"source_plugin":"aiapi"},{"name":"stats.product_rank","title":"","desc":"商品销量排行","rw":"read","permission":"ShopProduct\/index","module":"core:stats","is_delete":0,"params":{"type":"object","properties":{"start_date":{"type":"string"},"end_date":{"type":"string"},"limit":{"type":"integer","default":10}}},"source_plugin":"aiapi"},{"name":"upload.image","title":"","desc":"上传图片（url 或 base64），走 Pic::uploadoss 并写入素材库","rw":"write","permission":"Upload\/uploadFile","module":"core:upload","is_delete":0,"params":{"type":"object","properties":{"url":{"type":"string"},"image_base64":{"type":"string"},"name":{"type":"string"},"dry_run":{"type":"boolean"}}},"source_plugin":"aiapi"},{"name":"designer.component.list","title":"页面·排版组件","desc":"页面排版可用的组件类型。页面是从上到下排列，用组件顺序、间距和多图列数排版，没有自由坐标","rw":"read","permission":"DesignerPage\/index","module":"core:designer","is_delete":0,"params":{"type":"object","properties":{}},"source_plugin":"aiapi"},{"name":"designer.page.list","title":"页面·列表","desc":"装修页面列表。ishome：0普通 1首页 2个人中心 3分销中心。scene：normal、member、commission、restaurant_home、goods_page","rw":"read","permission":"DesignerPage\/index","module":"core:designer","is_delete":0,"params":{"type":"object","properties":{"page":{"type":"integer","default":1},"page_size":{"type":"integer","default":20},"keyword":{"type":"string"},"scene":{"type":"string","enum":["normal","member","commission","restaurant_home","goods_page"],"description":"页面场景。普通页可省略"},"ishome":{"type":"integer","enum":[0,1,2,3]}}},"source_plugin":"aiapi"},{"name":"designer.page.get","title":"页面·详情","desc":"读取装修页面。content 是组件数组，pageinfo 是页头和背景。改排版前先读这一份，保存时要提交完整 content","rw":"read","permission":"DesignerPage\/index","module":"core:designer","is_delete":0,"params":{"type":"object","required":["id"],"properties":{"id":{"type":"integer"}}},"source_plugin":"aiapi"},{"name":"designer.page.save","title":"页面·保存排版","desc":"新建或更新装修页面，含排版。content 按从上到下传组件，每项含 temp、params、data。间距用 params 的 margin_x、margin_y、padding_x、padding_y、bgcolor、borderradius。多图 temp=pictures，params.style：2两列 3三列 4四列 5橱窗 6滑动。单图 temp=picture，图片放 data[].imgurl。标题 temp=title，文本 temp=text，富文本 temp=richtext 且 HTML 放组件 content。pageinfo 可传 {title,bgcolor}，会写成页头。更新时未出现在 content 里的旧组件会被去掉。个人中心组件只能用于 scene=member；商品详情 scene=goods_page 必须含 goods_gallery、goods_price、goods_sku、goods_buybar。设首页请用 designer.page.set_home，不要在这里传 ishome=1。支持 dry_run","rw":"write","permission":"DesignerPage\/index","module":"core:designer","is_delete":0,"params":{"type":"object","required":["name","content"],"properties":{"id":{"type":"integer","description":"有值则更新，不传则新建"},"name":{"type":"string"},"content":{"description":"组件数组，或同等 JSON 字符串"},"pageinfo":{"description":"页头和背景。对象、数组或 JSON 字符串。更新时不传则保留原来的"},"scene":{"type":"string","enum":["normal","member","commission","restaurant_home","goods_page"],"description":"页面场景。普通页可省略"},"ishome":{"type":"integer","enum":[0,1,2,3],"description":"一般留空。1会替换当前首页"},"tab_contents":{"description":"标签页子内容，结构与后台保存一致"},"dry_run":{"type":"boolean"}}},"source_plugin":"aiapi"},{"name":"designer.page.copy","title":"页面·复制","desc":"复制一个装修页面，名称追加“-副本”，不占用首页。支持 dry_run","rw":"write","permission":"DesignerPage\/index","module":"core:designer","is_delete":0,"params":{"type":"object","required":["id"],"properties":{"id":{"type":"integer"},"scene":{"type":"string","enum":["normal","member","commission","restaurant_home","goods_page"],"description":"页面场景。普通页可省略"},"dry_run":{"type":"boolean"}}},"source_plugin":"aiapi"},{"name":"designer.template.use","title":"页面·套用模板","desc":"从模板库生成一个新装修页面，不会替换当前首页。scene 可传 member、restaurant_home、commission，空则跟随模板。支持 dry_run","rw":"write","permission":"DesignerPage\/index","module":"core:designer","is_delete":0,"params":{"type":"object","required":["template_id","page_name"],"properties":{"template_id":{"type":"integer"},"page_name":{"type":"string"},"scene":{"type":"string","enum":["member","restaurant_home","commission"]},"dry_run":{"type":"boolean"}}},"source_plugin":"aiapi"},{"name":"designer.page.set_home","title":"页面·设为首页","desc":"把已有页面设为首页、个人中心或分销中心，同类型原来的页面会被取消。ishome：1首页 2个人中心 3分销中心。餐饮首页不走这个操作。支持 dry_run","rw":"write","permission":"DesignerPage\/index","module":"core:designer","is_delete":0,"params":{"type":"object","required":["id"],"properties":{"id":{"type":"integer"},"ishome":{"type":"integer","enum":[1,2,3],"default":1},"dry_run":{"type":"boolean"}}},"source_plugin":"aiapi"},{"name":"designer.page.cancel_home","title":"页面·取消首页","desc":"取消页面的首页、个人中心或分销中心标记。餐饮首页会改为撤回发布。支持 dry_run","rw":"write","permission":"DesignerPage\/index","module":"core:designer","is_delete":0,"params":{"type":"object","required":["id"],"properties":{"id":{"type":"integer"},"dry_run":{"type":"boolean"}}},"source_plugin":"aiapi"},{"name":"customdiy.category.list","title":"品类·列表","desc":"个性定制白胚品类列表","rw":"read","permission":"CustomDiyApi\/categoryList","module":"plugin:customdiy","is_delete":0,"params":{"type":"object","properties":{}},"source_plugin":"customdiy"},{"name":"customdiy.category.save","title":"品类·保存","desc":"新建或更新品类。更新时传 id","rw":"write","permission":"CustomDiyApi\/categorySave","module":"plugin:customdiy","is_delete":0,"params":{"type":"object","properties":{"id":{"type":"integer"},"name":{"type":"string"},"pic":{"type":"string"},"description":{"type":"string"},"sort":{"type":"integer"},"status":{"type":"integer","enum":[0,1]},"dry_run":{"type":"boolean"}},"required":["name"]},"source_plugin":"customdiy"},{"name":"customdiy.product.list","title":"白胚·列表","desc":"白胚列表。status：1 上架，0 下架","rw":"read","permission":"CustomDiyApi\/productList","module":"plugin:customdiy","is_delete":0,"params":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"keyword":{"type":"string"},"category_id":{"type":"integer"},"status":{"type":"integer","enum":[0,1]}}},"source_plugin":"customdiy"},{"name":"customdiy.product.get","title":"白胚·详情","desc":"白胚详情，含款式 variants、印刷面 surfaces、尺码 sizes","rw":"read","permission":"CustomDiyApi\/productDetail","module":"plugin:customdiy","is_delete":0,"params":{"type":"object","properties":{},"required":["id"]},"source_plugin":"customdiy"},{"name":"customdiy.product.save","title":"白胚·保存","desc":"新建或更新白胚。必须带 category_id、name、surfaces。variants、sizes、price、cover_pic、detail 按后台保存结构传。更新时传 id，未传的结构字段会被服务按空值重写，改之前先 product.get","rw":"write","permission":"CustomDiyApi\/productSave","module":"plugin:customdiy","is_delete":0,"params":{"type":"object","properties":{"id":{"type":"integer"},"category_id":{"type":"integer"},"name":{"type":"string"},"cover_pic":{"type":"string"},"description":{"type":"string"},"detail":{"description":"商品详情，页面组件 JSON 或 HTML"},"price":{"type":"number"},"market_price":{"type":"number"},"freight_price":{"type":"number"},"stock":{"type":"integer"},"status":{"type":"integer","enum":[0,1]},"sort":{"type":"integer"},"variants":{"type":"array","description